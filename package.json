{
  "name": "web04-realticket",
  "version": "1.0.0",
  "description": "예매 서비스",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:front && npm run test:back",
    "test:front": "npm --prefix front run test -- --run",
    "test:back": "npm run test:back:unit && npm run test:e2e",
    "test:back:unit": "npm --prefix back run test:unit",
    "test:e2e": "npm --prefix back run test",
    "test:back:lua": "npm --prefix back run test:lua",
    "build": "npm run build:front && npm run build:back",
    "build:front": "npm --prefix front run build",
    "build:back": "npm --prefix back run build",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "branch": "node ./scripts/makeLinkedBranch.js"
  },
  "lint-staged": {
    "front/**/*.{ts,tsx}": [
      "npm --prefix front run lint",
      "npm --prefix front run prettier"
    ],
    "back/**/*.ts": [
      "npm --prefix back run lint",
      "npm --prefix back run prettier"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  }
}
