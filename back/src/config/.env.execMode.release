# 실제 서비스 시 실행 모드
# 수정에 주의 요함

# Redis 연결 모드 (true: Sentinel, false: 단일 호스트)
REDIS_SENTINEL_MODE=true

# 로깅 모드
LOGGING_MODE=prod

# 로그 저장 모드
LOG_SAVE_MODE=prod

# 벤치마크 모드
BENCHMARK_MODE=false

# 예매 시퀀스 상태 관리 모드
ENTERING_SESSION_EXPIRE_MODE=prod
DEVELOPING_WAITING_QUEUE_MODE=false
INFINITE_IN_BOOKING_POOL_SIZE=false

