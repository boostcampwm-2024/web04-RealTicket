# 테스트 환경 설정

# 표준 시간 설정
TZ=Asia/Seoul

# 데이터베이스 설정 (SQLite in-memory로 대체됨)
DATABASE_HOST=:memory:
DATABASE_PASSWORD=
DATABASE_PORT=0
DATABASE_SCHEMA=:memory:
DATABASE_SYNCHRONIZE=true
DATABASE_TYPE=better-sqlite3
DATABASE_USERNAME=

# Redis 설정 (ioredis-mock으로 대체됨)
REDIS_HOST=localhost
REDIS_PORT=6379

# 프론트엔드 URL
FRONT_URL=http://localhost:30000

# 로그 설정 (LOG_SAVE_MODE 미설정 시 파일 로그 비활성화)
LOG_MAX_SIZE=20m
LOG_MAX_LIFE=30d
LOG_ZIP=false
