# Copy to .env.monitoring on the monitoring host and fill secrets there.
ASG_NAME=realticket-nest-asg
AWS_REGION=ap-northeast-2

# Leave these empty when the EC2 instance has an IAM role with the required permissions.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
PROMETHEUS_RETENTION_TIME=6h
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

REDIS_HOST=10.0.142.170
REDIS_PORT=6379

DB_HOST=10.0.128.136
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=real_ticket

DRY_RUN=true
MIN_REPLICAS=1
MAX_REPLICAS=4
POLL_INTERVAL=5
METRICS_LOG=true
SCALE_UP_THRESHOLD=50
SCALE_DOWN_THRESHOLD=30
COOLDOWN_UP=120
COOLDOWN_DOWN=300
COOLDOWN_DOWN_AFTER_UP=300
